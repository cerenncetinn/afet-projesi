{
  "expo": {
    "name": "afet-projesi",
    "slug": "afet-projesi",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "afetprojesi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/afet_yonetimi_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2633"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/afet_yonetimi_logo.png",
        "backgroundColor": "#1A2633"
      }
    },

    "ios": {
      "supportsTablet": true
    },

    "web": {
      "output": "static"
    },

    "plugins": ["expo-router"],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
